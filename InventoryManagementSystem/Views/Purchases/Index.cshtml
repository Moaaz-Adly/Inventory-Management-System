@model IEnumerable<InventoryManagementSystem.Models.Purchase>

@{
    ViewData["Title"] = "Purchase History";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Purchase History</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Purchase Invoice</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Purchase ID</th>
            <th>Supplier</th>
            <th>Purchase Date</th>
            <th>Items Count</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.PurchaseId</td>
                    <td>@item.Supplier?.SupplierName</td>
                    <td>@item.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.PurchaseItems?.Count</td>
                    <td>@item.TotalAmount.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.PurchaseId" class="btn btn-info btn-sm text-white">Details</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No purchase records found.</td>
            </tr>
        }
    </tbody>
</table>