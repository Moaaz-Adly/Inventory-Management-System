@model IEnumerable<InventoryManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Supplier Products";
}

<div class="container py-4">

    ```
    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Supplier Products</h1>
        <p class="text-muted">View all products provided by this supplier</p>
    </div>

    <!-- Products Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-0">
                        No products found for this supplier.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Product Name</th>
                                <th>SKU</th>
                                <th>Unit Price</th>
                                <th>Stock Quantity</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @product.ProductName
                                    </td>

                                    <td>
                                        @product.SKU
                                    </td>

                                    <td>
                                        @product.UnitPrice.ToString("0.00")
                                    </td>

                                    <td>
                                        @product.StockQuantity
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-3">
        <a asp-action="Index"
           class="btn btn-light px-4">
            ← Back to Suppliers
        </a>
    </div>
    ```

</div>
