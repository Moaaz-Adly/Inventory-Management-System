@model InventoryManagementSystem.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container py-4">

    ```
    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Supplier Details</h1>
        <p class="text-muted">View supplier information</p>
    </div>

    <!-- Details Card -->
    <div class="card border-0 shadow-sm" style="max-width: 700px;">
        <div class="card-body p-4">

            <!-- Supplier Name -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Supplier Name
                </label>

                <div class="form-control bg-light">
                    @Html.DisplayFor(model => model.SupplierName)
                </div>
            </div>

            <!-- Contact Name -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Contact Name
                </label>

                <div class="form-control bg-light">
                    @Html.DisplayFor(model => model.ContactName)
                </div>
            </div>

            <!-- Phone -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Phone
                </label>

                <div class="form-control bg-light">
                    @Html.DisplayFor(model => model.Phone)
                </div>
            </div>

            <!-- Email -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Email
                </label>

                <div class="form-control bg-light">
                    @Html.DisplayFor(model => model.Email)
                </div>
            </div>

            <!-- Address -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Address
                </label>

                <div class="form-control bg-light">
                    @Html.DisplayFor(model => model.Address)
                </div>
            </div>

            <!-- Buttons -->
            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model?.SupplierId"
                   class="btn btn-primary px-4">
                    Edit Supplier
                </a>

                <a asp-action="Index"
                   class="btn btn-light px-4">
                    ← Back to Suppliers
                </a>

            </div>

        </div>
    </div>
    ```

</div>
