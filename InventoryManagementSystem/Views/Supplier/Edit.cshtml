@model InventoryManagementSystem.Models.Supplier

@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="container py-4">

    ```
    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Edit Supplier</h1>
        <p class="text-muted">Update supplier information</p>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm" style="max-width: 700px;">
        <div class="card-body p-4">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- Supplier ID -->
                <input type="hidden" asp-for="SupplierId" />

                <!-- Supplier Name -->
                <div class="mb-4">
                    <label asp-for="SupplierName"
                           class="form-label fw-semibold">
                        Supplier Name
                    </label>

                    <input asp-for="SupplierName"
                           class="form-control"
                           placeholder="Enter supplier name" />

                    <span asp-validation-for="SupplierName"
                          class="text-danger small"></span>
                </div>

                <!-- Contact Name -->
                <div class="mb-4">
                    <label asp-for="ContactName"
                           class="form-label fw-semibold">
                        Contact Name
                    </label>

                    <input asp-for="ContactName"
                           class="form-control"
                           placeholder="Enter contact name" />

                    <span asp-validation-for="ContactName"
                          class="text-danger small"></span>
                </div>

                <!-- Phone -->
                <div class="mb-4">
                    <label asp-for="Phone"
                           class="form-label fw-semibold">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Enter phone number" />

                    <span asp-validation-for="Phone"
                          class="text-danger small"></span>
                </div>

                <!-- Email -->
                <div class="mb-4">
                    <label asp-for="Email"
                           class="form-label fw-semibold">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           placeholder="Enter email address" />

                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <!-- Address -->
                <div class="mb-4">
                    <label asp-for="Address"
                           class="form-label fw-semibold">
                        Address
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Enter supplier address"></textarea>

                    <span asp-validation-for="Address"
                          class="text-danger small"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-light px-4">
                        ← Back to Suppliers
                    </a>
                </div>

            </form>

        </div>
    </div>
    ```

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
