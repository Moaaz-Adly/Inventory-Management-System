@using InventoryManagementSystem.Models.ViewModel
@model DashboardViewModel

@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="container-fluid" dir="rtl">

    <!-- Page Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">
                <i class="fa-solid fa-gauge me-2"></i>
                Dashboard
            </h3>

            <p class="text-muted mb-0">
                Overview of Inventory, Sales, and Purchases
            </p>
        </div>
    </div>


    <!-- ================= KPI CARDS ================= -->

    <div class="row g-3 mb-4">

        <!-- Total Products -->
        <div class="col-12 col-sm-6 col-lg-2">
            <div class="kpi-card bg-kpi-1 d-flex justify-content-between align-items-center">
                <div>
                    <div>Total products</div>
                    <h3>@Model.TotalProducts</h3>
                </div>

                <i class="fa-solid fa-box kpi-icon"></i>
            </div>
        </div>


        <!-- Total Categories -->
        <div class="col-12 col-sm-6 col-lg-2">
            <div class="kpi-card bg-kpi-6 d-flex justify-content-between align-items-center">
                <div>
                    <div>Total Categories</div>
                    <h3>@Model.TotalCategories</h3>
                </div>

                <i class="fa-solid fa-tags kpi-icon"></i>
            </div>
        </div>


        <!-- Total Suppliers -->
        <div class="col-12 col-sm-6 col-lg-2">
            <div class="kpi-card bg-kpi-5 d-flex justify-content-between align-items-center">
                <div>
                    <div>Total Suppliers</div>
                    <h3>@Model.TotalSuppliers</h3>
                </div>

                <i class="fa-solid fa-truck kpi-icon"></i>
            </div>
        </div>


        <!-- Total Stock -->
        <div class="col-12 col-sm-6 col-lg-2">
            <div class="kpi-card bg-kpi-2 d-flex justify-content-between align-items-center">
                <div>
                    <div>Total Stock </div>
                    <h3>@Model.TotalStockQuantity</h3>
                </div>

                <i class="fa-solid fa-warehouse kpi-icon"></i>
            </div>
        </div>


        <!-- Low Stock -->
        <div class="col-12 col-sm-6 col-lg-2">
            <div class="kpi-card bg-kpi-4 d-flex justify-content-between align-items-center">
                <div>
                    <div>Low stock</div>
                    <h3>@Model.LowStockCount</h3>
                </div>

                <i class="fa-solid fa-triangle-exclamation kpi-icon"></i>
            </div>
        </div>


        <!-- Sales -->
        <div class="col-12 col-sm-6 col-lg-2">
            <div class="kpi-card bg-kpi-3 d-flex justify-content-between align-items-center">
                <div>
                    <div>Total Sales</div>

                    <h3>
                        @Model.TotalSalesAmount.ToString("N0")
                        <small>EGP</small>
                    </h3>
                </div>

                <i class="fa-solid fa-sack-dollar kpi-icon"></i>
            </div>
        </div>

    </div>


    <!-- ================= PURCHASES / SALES ================= -->

    <div class="row g-3 mb-4">

        <!-- Purchases -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="mb-3">
                        <i class="fa-solid fa-cart-shopping me-2"></i>
                        Total purchases
                    </h5>

                    <div class="row">

                        <div class="col-6">

                            <div class="text-muted small">
                                Number of operations
                            </div>

                            <h4 class="mt-1">
                                @Model.TotalPurchasesCount
                            </h4>

                        </div>


                        <div class="col-6">

                            <div class="text-muted small">
                                Total Value
                            </div>

                            <h4 class="mt-1">
                                @Model.TotalPurchasesAmount.ToString("N2")
                                <small>EGP</small>
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Sales -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="mb-3">
                        <i class="fa-solid fa-money-bill-trend-up me-2"></i>
                        Total Sales
                    </h5>

                    <div class="row">

                        <div class="col-6">

                            <div class="text-muted small">
                                Number of operations
                            </div>

                            <h4 class="mt-1">
                                @Model.TotalSalesCount
                            </h4>

                        </div>


                        <div class="col-6">

                            <div class="text-muted small">
                                Total Value
                            </div>

                            <h4 class="mt-1">
                                @Model.TotalSalesAmount.ToString("N2")
                                <small>EGP</small>
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= CHART / LOW STOCK ================= -->

    <div class="row g-3 mb-4">

        <!-- Chart -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="mb-3">
                        <i class="fa-solid fa-chart-column me-2"></i>
                        best seller
                    </h5>

                    <div style="height:300px;">
                        <canvas id="topProductsChart"></canvas>
                    </div>

                </div>

            </div>

        </div>


        <!-- Low Stock Products -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        Low-stock products
                    </h5>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>

                                <tr>
                                    <th>The Product</th>
                                    <th>Category</th>
                                    <th>Quantity</th>
                                    <th>minimum</th>
                                </tr>

                            </thead>

                            <tbody>

                                @if (Model.LowStockProducts.Any())
                                {
                                    foreach (var product in Model.LowStockProducts)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @product.ProductName
                                                </strong>
                                            </td>

                                            <td>
                                                @(product.Category?.CategoryName ?? "-")
                                            </td>

                                            <td>

                                                <span class="badge bg-danger">
                                                    @product.StockQuantity
                                                </span>

                                            </td>

                                            <td>
                                                @product.LowStockThreshold
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="4"
                                            class="text-center text-muted py-4">

                                            <i class="fa-solid fa-circle-check me-2"></i>

                                            There are currently no low-stock products 

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= RECENT ACTIVITY ================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h5 class="mb-3">
                <i class="fa-solid fa-clock-rotate-left me-2"></i>
                Latest Activities
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Date</th>
                            <th>Value</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.RecentActivity.Any())
                        {
                            foreach (var activity in Model.RecentActivity)
                            {
                                <tr>

                                    <td>

                                        @if (activity.Type == "بيع")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa-solid fa-cart-shopping me-1"></i>
                                                sale
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                <i class="fa-solid fa-box-open me-1"></i>
                                                buying
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @activity.Description
                                    </td>


                                    <td>
                                        @activity.Date.ToString("yyyy-MM-dd HH:mm")
                                    </td>


                                    <td>

                                        <strong>
                                            @activity.Amount.ToString("N2")
                                            EGP
                                        </strong>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    <i class="fa-solid fa-inbox me-2"></i>

                                    No recent activity yet.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ================= CHART JS ================= -->
@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <script>

        const topProductsLabels =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.MostSoldProducts.Select(p => p.ProductName)
                )
                );

    const topProductsData =
        @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                Model.MostSoldProducts.Select(p => p.TotalQuantitySold)
                        )
                );


    const chartElement =
        document.getElementById("topProductsChart");


    if (chartElement) {

        new Chart(chartElement, {

            type: "bar",

            data: {

                labels: topProductsLabels.length
                    ? topProductsLabels
                    : ["No data yet"],

                datasets: [

                    {
                        label: "Quantity sold",

                        data: topProductsData.length
                            ? topProductsData
                            : [0],

                        backgroundColor: "#6366f1",

                        borderRadius: 6,

                        borderWidth: 0
                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        display: false
                    }

                },

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        }

                    }

                }

            }

        });

    }

</script>
}