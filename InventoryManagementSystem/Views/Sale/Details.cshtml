@model InventoryManagementSystem.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<h1>Sale Details</h1>

<div class="card">
    <div class="card-body">

        <h4>Sale #@Model.SaleId</h4>

        <hr />

        <dl class="row">

            <dt class="col-sm-3">
                Sale Date
            </dt>

            <dd class="col-sm-9">
                @Model.SaleDate.ToString("yyyy-MM-dd HH:mm")
            </dd>

            <dt class="col-sm-3">
                Customer Info
            </dt>

            <dd class="col-sm-9">
                @(string.IsNullOrEmpty(Model.CustomerInfo)
                                ? "N/A"
                                : Model.CustomerInfo)
            </dd>

            <dt class="col-sm-3">
                Total Amount
            </dt>

            <dd class="col-sm-9">
                <strong>
                    @Model.TotalAmount.ToString("0.00")
                </strong>
            </dd>

        </dl>

        <h4 class="mt-4">Sale Items</h4>

        <table class="table table-bordered">

            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Item Total</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.SaleItems)
                {
                    <tr>

                        <td>
                            @item.Product.ProductName
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            @item.UnitPrice.ToString("0.00")
                        </td>

                        <td>
                            @((item.Quantity * item.UnitPrice).ToString("0.00"))
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div class="text-end">

            <h4>
                Total:
                @Model.TotalAmount.ToString("0.00")
            </h4>

        </div>

    </div>
</div>

<div class="mt-3">

    <a asp-action="Receipt"
       asp-route-id="@Model.SaleId"
       class="btn btn-success">
        View Receipt
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Sales
    </a>

</div>