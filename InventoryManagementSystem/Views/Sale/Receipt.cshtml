@model InventoryManagementSystem.Models.Sale

@{
    ViewData["Title"] = "Receipt";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-body">

            <div class="text-center">
                <h2>Sales Receipt</h2>
                <p>Inventory Management System</p>
            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-6">
                    <strong>Sale ID:</strong>
                    @Model.SaleId
                </div>

                <div class="col-md-6">
                    <strong>Date:</strong>
                    @Model.SaleDate.ToString("yyyy-MM-dd HH:mm")
                </div>

            </div>

            <div class="mb-3">
                <strong>Customer:</strong>

                @(string.IsNullOrEmpty(Model.CustomerInfo)
                                ? "N/A"
                                : Model.CustomerInfo)
            </div>

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.SaleItems)
                    {
                        <tr>

                            <td>
                                @item.Product.ProductName
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td>
                                @item.UnitPrice.ToString("0.00")
                            </td>

                            <td>
                                @((item.Quantity * item.UnitPrice).ToString("0.00"))
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <div class="text-end mt-3">

                <h4>
                    Total Amount:
                    @Model.TotalAmount.ToString("0.00")
                </h4>

            </div>

            <hr />

            <div class="text-center">
                <p>Thank you for your purchase!</p>
            </div>

        </div>

    </div>

    <div class="mt-3">

        <button onclick="window.print()"
                class="btn btn-primary">
            Print Receipt
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Sales
        </a>

    </div>

</div>