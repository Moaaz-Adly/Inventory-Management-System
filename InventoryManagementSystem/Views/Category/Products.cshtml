@{
}
@model InventoryManagementSystem.Models.Category

@{
    ViewData["Title"] = "Category Products";
}

<h1>Products in @Model.CategoryName</h1>

<table class="table">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>SKU</th>
            <th>Unit Price</th>
            <th>Stock Quantity</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.ProductName</td>
                <td>@product.SKU</td>
                <td>@product.UnitPrice</td>
                <td>@product.StockQuantity</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to Categories</a>