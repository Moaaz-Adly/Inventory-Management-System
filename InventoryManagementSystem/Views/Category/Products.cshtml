@model InventoryManagementSystem.Models.Category

@{
    ViewData["Title"] = "Category Products";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Products in @Model.CategoryName</h1>
        <p class="text-muted">
            View all products belonging to this category
        </p>
    </div>

    <!-- Products Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (Model.Products.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Product Name</th>
                                <th>SKU</th>
                                <th>Unit Price</th>
                                <th>Stock Quantity</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td class="px-4 fw-semibold">
                                        @product.ProductName
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @product.SKU
                                        </span>
                                    </td>

                                    <td>
                                        @product.UnitPrice.ToString("C")
                                    </td>

                                    <td>
                                        @product.StockQuantity
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5 class="text-muted">No Products Found</h5>
                    <p class="text-muted mb-0">
                        There are no products in this category yet.
                    </p>
                </div>
            }

        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-4">
        <a asp-action="Index"
           class="btn btn-light px-4">
            ← Back to Categories
        </a>
    </div>

</div>