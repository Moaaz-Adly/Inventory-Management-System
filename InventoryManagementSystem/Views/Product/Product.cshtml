@model List<Product>

@{
    ViewData["Title"] = "Stock Browsing";
}

<style>
    .stock-wrapper {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .hero-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 20px;
        color: #ffffff;
    }

    .glass-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    }

    .custom-table {
        margin-bottom: 0;
    }

        .custom-table thead th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #e2e8f0;
            padding: 1rem;
        }

        .custom-table tbody td {
            padding: 1rem;
            vertical-align: middle;
            color: #1e293b;
            font-weight: 500;
            border-bottom: 1px solid #f1f5f9;
        }

        .custom-table tbody tr:hover {
            background-color: #f8fafc;
        }

        .custom-table tbody tr:last-child td {
            border-bottom: none;
        }
</style>

<div class="container my-4 stock-wrapper">
    <!-- Top Bar Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-semibold">
            ← Back to Products
        </a>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
            Total Items: @Model.Count()
        </span>
    </div>

    <!-- Header Banner -->
    <div class="hero-card p-4 p-md-5 mb-4 shadow-lg position-relative overflow-hidden">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-bold fs-7">
                        Inventory Monitoring
                    </span>
                </div>
                <h1 class="display-6 fw-bold mb-1 text-white">Stock Browsing</h1>
                <p class="text-light opacity-50 mb-0">Real-time status and stock threshold analysis</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="icon-box bg-white bg-opacity-10 p-3 rounded-4 d-inline-block text-center ms-auto">
                    <span class="fs-1">📦</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Modern Table Container -->
    <div class="glass-card overflow-hidden">
        <div class="table-responsive">
            <table class="table custom-table align-middle">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>SKU Identification</th>
                        <th class="text-center">Stock Quantity</th>
                        <th class="text-center">Low Stock Threshold</th>
                        <th class="text-center">Availability Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-dark d-block">@product.ProductName</span>
                            </td>
                            <td>
                                <code class="fw-bold text-primary">@product.SKU</code>
                            </td>
                            <td class="text-center">
                                <span class="fw-bold fs-6">@product.StockQuantity</span>
                            </td>
                            <td class="text-center">
                                <span class="text-muted fw-semibold">@product.LowStockThreshold</span>
                            </td>
                            <td class="text-center">
                                @if (product.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                        🔴 Out of Stock
                                    </span>
                                }
                                else if (product.StockQuantity <= product.LowStockThreshold)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                        ⚠️ Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                        ✅ In Stock
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>