@using InventoryManagementSystem.Models.ViewModel
@model AddProVM

@{
    ViewData["Title"] = "Add New Product";
}

<style>
    .form-wrapper {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .hero-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 20px;
        color: #ffffff;
    }

    .glass-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    }

    .form-label {
        font-size: 0.85rem;
        color: #475569;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.4rem;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        padding: 0.65rem 0.9rem;
        font-weight: 500;
        color: #1e293b;
        transition: all 0.2s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }
</style>

<div class="container my-4 form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-semibold d-inline-flex align-items-center gap-2">
            ← Back to Products
        </a>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
            New Entry
        </span>
    </div>
    <div class="hero-card p-4 p-md-5 mb-4 shadow-lg position-relative overflow-hidden">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-bold fs-7">
                        Inventory Creation
                    </span>
                </div>
                <h1 class="display-6 fw-bold mb-1 text-white">Add New Product</h1>
                <p class="text-light opacity-50 mb-0">Fill in the specification details to register a product in the system</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="icon-box bg-white bg-opacity-10 p-3 rounded-4 d-inline-block text-center ms-auto">
                    <span class="fs-1"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="glass-card p-4 p-md-5">
        <form asp-action="SaveAdd" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="ProSKU" class="form-label">Product SKU</label>
                    <input asp-for="ProSKU" class="form-control" placeholder="e.g. PROD-1092" />
                    <span asp-validation-for="ProSKU" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ProName" class="form-label">Product Name</label>
                    <input asp-for="ProName" class="form-control" placeholder="e.g. Wireless Mouse" />
                    <span asp-validation-for="ProName" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">-- Select Category --</option>
                        @if (Model.categories != null)
                        {
                            foreach (var category in Model.categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.CategoryName
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProPrice" class="form-label">Unit Price ($)</label>
                    <input asp-for="ProPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="ProPrice" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" />
                    <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LowStockQuantity" class="form-label">Low Stock Threshold</label>
                    <input asp-for="LowStockQuantity" type="number" class="form-control" placeholder="0" />
                    <span asp-validation-for="LowStockQuantity" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-semibold">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold d-inline-flex align-items-center gap-2">
                    <span>💾</span> Save Product
                </button>
            </div>
        </form>
    </div>
</div>